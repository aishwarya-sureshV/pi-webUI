{
  "name": "pi-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "DeepSeek-harness-style web UI for the local pi coding agent (pi --mode rpc)",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "node server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test server/ src/lib/",
    "check:grok": "node server/grok-selfcheck.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@zed-industries/agent-client-protocol": "^0.4.5",
    "node-pty": "^1.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^6.0.0"
  }
}
