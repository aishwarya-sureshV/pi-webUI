#!/usr/bin/env bash
# pi-web launcher: `pi` opens the web workbench; `pi --tui` (or piped stdin)
# falls through to the real terminal TUI.
set -euo pipefail

LAUNCHER_NAME="pi-web"
# shellcheck source=lib/pi-web-launcher.sh
source "$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/pi-web-launcher.sh"
resolve_pi_web_root
REAL_PI="/opt/homebrew/lib/node_modules/@earendil-works/pi-coding-agent/dist/cli.js"

if [[ "${1:-}" == "--stop" ]]; then
  server_pid="$(lsof -tiTCP:"$PORT" -sTCP:LISTEN 2>/dev/null | head -1 || true)"
  if [[ -z "$server_pid" ]]; then
    echo "pi-web: not running"
    exit 0
  fi
  server_command="$(ps -p "$server_pid" -o command= 2>/dev/null || true)"
  if [[ "$server_command" != *"server/index.js"* ]]; then
    echo "pi-web: port $PORT is in use by another application" >&2
    exit 1
  fi
  kill -TERM "$server_pid" 2>/dev/null || true
  for _ in $(seq 1 20); do
    lsof -tiTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1 || { echo "pi-web: stopped"; exit 0; }
    sleep 0.1
  done
  echo "pi-web: did not release port $PORT" >&2
  exit 1
fi

passthrough=false
for arg in "$@"; do
  case "$arg" in
    --tui) passthrough=true ;;
  esac
done

# Non-interactive stdin, or explicit opt-outs, or flags that belong to the CLI
# (help/version/print/rpc/list) -> delegate to the real terminal agent.
if [[ "$passthrough" == "true" ]]; then
  # strip the --tui flag itself before delegating
  args=()
  for arg in "$@"; do [[ "$arg" != "--tui" ]] && args+=("$arg"); done
  exec node "$REAL_PI" "${args[@]}"
fi

if [[ ! -t 0 ]]; then
  exec node "$REAL_PI" "$@"
fi

for arg in "$@"; do
  case "$arg" in
    --help|-h|--version|-v|--print|-p|--mode|--list-models|--continue|-c|--resume|-r)
      exec node "$REAL_PI" "$@"
      ;;
  esac
done

# Otherwise: launch the web workbench and open the browser.
ensure_build
refresh_stale_server
start_server
open_workbench ""
