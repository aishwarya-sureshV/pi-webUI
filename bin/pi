#!/usr/bin/env bash
# pi-web launcher: `pi` opens the web workbench; `pi --tui` (or piped stdin)
# falls through to the real terminal TUI.
set -euo pipefail

PI_WEB_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
REAL_PI="/opt/homebrew/lib/node_modules/@earendil-works/pi-coding-agent/dist/cli.js"
PORT="${PI_WEB_PORT:-4319}"
HOST="${PI_WEB_HOST:-127.0.0.1}"

passthrough=false
for arg in "$@"; do
  case "$arg" in
    --tui) passthrough=true ;;
  esac
done

# Non-interactive stdin, or explicit opt-outs, or flags that belong to the CLI
# (help/version/print/rpc/list) -> delegate to the real terminal agent.
if [[ "$passthrough" == "true" ]]; then
  # strip the --tui flag itself before delegating
  args=()
  for arg in "$@"; do [[ "$arg" != "--tui" ]] && args+=("$arg"); done
  exec node "$REAL_PI" "${args[@]}"
fi

if [[ ! -t 0 ]]; then
  exec node "$REAL_PI" "$@"
fi

for arg in "$@"; do
  case "$arg" in
    --help|-h|--version|-v|--print|-p|--mode|--list-models|--continue|-c|--resume|-r)
      exec node "$REAL_PI" "$@"
      ;;
  esac
done

# Otherwise: launch the web workbench and open the browser.
if ! curl -sf "http://$HOST:$PORT/api/health" >/dev/null 2>&1; then
  if [[ ! -d "$PI_WEB_ROOT/dist" ]]; then
    echo "pi-web: building web assets (first run)…" >&2
    (cd "$PI_WEB_ROOT" && npm run build) >&2
  fi
  nohup node "$PI_WEB_ROOT/server/index.js" >/tmp/pi-web.log 2>&1 &
  for _ in $(seq 1 50); do
    curl -sf "http://$HOST:$PORT/api/health" >/dev/null 2>&1 && break
    sleep 0.1
  done
fi

open "http://$HOST:$PORT"
