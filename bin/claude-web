#!/usr/bin/env bash
# Claude Code launcher for pi-web. This is additive: it never intercepts or
# forwards the real `claude` command.
set -euo pipefail

LAUNCHER_NAME="claude-web"
# shellcheck source=lib/pi-web-launcher.sh
source "$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/pi-web-launcher.sh"
resolve_pi_web_root

ensure_build
refresh_stale_server
start_server
open_workbench "backend=claude"
